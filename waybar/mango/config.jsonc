{
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "reload_style_on_change": true,

    "modules-left": [
        "mango/workspaces"
    ],

    "modules-center": [
        "mango/window"
    ],

    "modules-right": [
        "group/expand",
        "tray",
        "group/stats",
        "network",
        "custom/power"
    ],

    "group/stats": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio#source",
            "cpu",
            "memory",
            "custom/gpu",
            "clock"
        ]
    },

    "mango/window": {
        "format": "{app_id}  {title}",
        "max-length": 50,
        "tooltip": false
    },

    "mango/workspaces": {
        "format": "{name}",
        "tooltip": false,
        "on-click": "activate",
        "on-click-right": "toggle",
        "disable-markup": false
    },

    "tray": {
        "icon-size": 18,
        "spacing": 0,
        "tooltip": true
    },

    "pulseaudio#source": {
        "format": "{icon} {volume}%",
        "on-click": "pavucontrol",
        "format-muted": "  ",
        "tooltip": true,
        "tooltip-format": "Volume: {volume}%",
        "format-icons": {
            "headphone": "",
            "default": ["", "", ""]
        },
        "scroll-step": 5
    },

    "memory": {
        "format": "mem: {used:0.1f}G/{total:0.1f}G",
        "tooltip": false,
        "interval": 2
    },

    "cpu": {
        "format": "cpu: {usage}%",
        "tooltip": false,
        "interval": 2
    },

    "clock": {
        "format": "{:%H:%M   %d:%m:%Y}",
        "on-click": "gnome-calendar",
        "tooltip": false
    },

    "custom/power": {
        "format": "<span font='16'>⏻</span>",
        "tooltip": "Power menu",
        "on-click": "~/.config/rofi/applets/bin/powermenu.sh"
    },

    "custom/gpu": {
        "format": "gpu: {}%",
        "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
        "interval": 2
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": " eth",
        "format-disconnected": "⚠  offline",
        "tooltip": false,
        "on-click": "nm-connection-editor"
    }
}
