{
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "reload_style_on_change": true,

    "modules-left": [
        "mango/workspaces"
    ],

    "modules-center": [
        "mango/window"
    ],

    "modules-right": [
        "group/expand",
        "tray",
        "pulseaudio#source",
        "cpu",
        "memory",
        "clock",
        "custom/power"
    ],

    "mango/window": {
        "format": "{app_id}  {title}",
        "max-length": 50,
        "tooltip": false
    },

    "mango/workspaces": {
        "format": "{name}",
        "tooltip": false,
        "on-click": "activate",
        "on-click-right": "toggle",
        "disable-markup": false
    },

    "tray": {
        "icon-size": 18,
        "spacing": 0,
        "tooltip": true
    },

    "pulseaudio#source": {
        "format": "{icon} {volume}%",
        "on-click": "pavucontrol",
        "format-muted": "󰝟",
        "tooltip": true,
        "tooltip-format": "Volume: {volume}%",
        "format-icons": {
            "headphone": "",
            "default": ["", "", ""]
        },
        "scroll-step": 5
    },

    "memory": {
        "format": "mem: {used:0.1f}G/{total:0.1f}G",
        "tooltip": false,
        "interval": 4
    },

    "cpu": {
        "format": "cpu: {usage}%",
        "tooltip": false
    },

    "clock": {
        "format": "{:%H:%M   %d:%m:%Y}",
        "format-alt": "{:%A, %B %d, %Y (%R)} 󰃰",
        "tooltip": false
    },

    "custom/power": {
        "format": "<span font='16'>⏻</span>",
        "tooltip": "Power menu",
        "on-click": "~/.config/rofi/applets/bin/powermenu.sh"
    }
}

