{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "css-priority": "application",
  "control-center-width": 360,
  "control-center-height": 550,
  "notification-window-width": 380,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "title",
    "dnd",
    "notifications",
    "mpris",
    "volume",
    "backlight",
    "buttons-grid"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
      "image-size": 64,
      "image-radius": 6
    },
    "volume": {
      "label": "󰕾"
    },
    "backlight": {
      "label": "󰃟"
    },
    "buttons-grid": {
      "buttons": [
        {
          "label": "󰂯",
          "command": "blueman-manager"
        },
        {
          "label": "󰂚",
          "command": "swaync-client -d -t"
        },
        {
          "label": "󰖩",
          "command": "nm-connection-editor"
        },
        {
          "label": "󰌾",
          "command": "swaylock"
        }
      ]
    }
  }
}
